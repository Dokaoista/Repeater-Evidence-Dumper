# --- Engagement evidence: NEVER commit --------------------------------------
# These directories hold requests, responses and screenshots of real targets.
# They stay listed even though the repo is separate from the runtime directory,
# in case someone clones into ~/burp-evidence/ and runs the watcher there.
inbox/
out/
.failed/
.watcher.lock/
watch.log
watch.log.tmp

# --- Build ------------------------------------------------------------------
build/
.gradle/
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.class

# --- Render artifacts -------------------------------------------------------
# shot.mjs writes an .html next to the .png; it is only useful for debugging a
# failed render and is normally deleted at the end.
*.html
!samples/*.html

# --- OS / editor cruft ------------------------------------------------------
.DS_Store
*.bak
*.swp
.idea/
.vscode/

# Release staging area (jar + notes), not committed
dist/
